{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verifier/verdict-schema.json",
  "title": "Verifier verdict file",
  "description": "One file per verification run. The overall verdict rule is enforced: any Failed claim gives Fail; otherwise any Unverified high-risk claim gives Inconclusive; an empty claim list gives Inconclusive; otherwise Pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "date",
    "repo",
    "task",
    "builder_model",
    "verifier_model",
    "profile",
    "overall_verdict",
    "claims",
    "rules",
    "observations",
    "audit"
  ],
  "properties": {
    "run_id": {
      "description": "Unique id for the run, also used as the file name. Suggested form: UTC timestamp plus a short random suffix.",
      "type": "string",
      "minLength": 1
    },
    "date": {
      "description": "When the verification ran, as an ISO 8601 UTC date-time.",
      "type": "string",
      "format": "date-time"
    },
    "repo": {
      "description": "The repository under review, for example org/repo-name.",
      "type": "string",
      "minLength": 1
    },
    "task": {
      "description": "The task as the requester stated it.",
      "type": "string",
      "minLength": 1
    },
    "builder_model": {
      "description": "The model that did the work. Include the provider where possible, for example openai/gpt-x.",
      "type": "string",
      "minLength": 1
    },
    "verifier_model": {
      "description": "The model that verified it. Include the provider where possible, for example anthropic/claude-opus-x.",
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "description": "null for the core verifier; rule-compliance when the rule-compliance profile was active.",
      "enum": [null, "rule-compliance"]
    },
    "overall_verdict": {
      "enum": ["Pass", "Fail", "Inconclusive"]
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "rules": {
      "description": "Rule applicability map and compliance results. Empty unless the rule-compliance profile was active.",
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "rationalisations": {
      "description": "Optional. Excuses the builder gave for not following a rule. Empty array: searched, none found. Absent: not searched.",
      "type": "array",
      "items": { "$ref": "#/$defs/rationalisation" }
    },
    "observations": {
      "description": "Findings outside the claims, and reasons for an Inconclusive verdict (empty claim list, no independent model, invalid verifier output).",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "audit": {
      "description": "Reserved for a second-line auditor. Always null until that exists.",
      "type": "null"
    }
  },
  "allOf": [
    {
      "description": "Any Failed claim gives Fail.",
      "if": {
        "properties": { "claims": { "contains": { "$ref": "#/$defs/failedClaim" } } }
      },
      "then": {
        "properties": { "overall_verdict": { "const": "Fail" } }
      }
    },
    {
      "description": "No Failed claim, but an Unverified high-risk claim, gives Inconclusive.",
      "if": {
        "properties": {
          "claims": {
            "not": { "contains": { "$ref": "#/$defs/failedClaim" } },
            "contains": { "$ref": "#/$defs/unverifiedHighRiskClaim" }
          }
        }
      },
      "then": {
        "properties": { "overall_verdict": { "const": "Inconclusive" } }
      }
    },
    {
      "description": "An empty claim list gives Inconclusive.",
      "if": {
        "properties": { "claims": { "maxItems": 0 } }
      },
      "then": {
        "properties": { "overall_verdict": { "const": "Inconclusive" } }
      }
    },
    {
      "description": "Otherwise Pass: at least one claim, none Failed, none Unverified and high-risk.",
      "if": {
        "properties": {
          "claims": {
            "minItems": 1,
            "not": {
              "anyOf": [
                { "contains": { "$ref": "#/$defs/failedClaim" } },
                { "contains": { "$ref": "#/$defs/unverifiedHighRiskClaim" } }
              ]
            }
          }
        }
      },
      "then": {
        "properties": { "overall_verdict": { "const": "Pass" } }
      }
    }
  ],
  "$defs": {
    "nullableText": {
      "type": ["string", "null"]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "failedClaim": {
      "type": "object",
      "required": ["verdict"],
      "properties": { "verdict": { "const": "Failed" } }
    },
    "unverifiedHighRiskClaim": {
      "type": "object",
      "required": ["verdict", "risk"],
      "properties": {
        "verdict": { "const": "Unverified" },
        "risk": { "const": "high" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "risk", "verdict", "method", "evidence", "expected", "observed", "repro"],
      "properties": {
        "claim": { "$ref": "#/$defs/text" },
        "risk": { "enum": ["high", "medium", "low"] },
        "verdict": { "enum": ["Verified", "Failed", "Unverified"] },
        "method": {
          "description": "How the evidence was gathered. null only for an Unverified claim where nothing could be checked.",
          "enum": ["executed", "inspected", null]
        },
        "evidence": {
          "description": "Commands, output excerpts, file and line references. For Unverified, why it could not be checked.",
          "$ref": "#/$defs/text"
        },
        "expected": { "$ref": "#/$defs/nullableText" },
        "observed": { "$ref": "#/$defs/nullableText" },
        "repro": { "$ref": "#/$defs/nullableText" }
      },
      "allOf": [
        {
          "description": "A Failed claim must say what was expected, what was observed and how to reproduce it.",
          "if": { "properties": { "verdict": { "const": "Failed" } } },
          "then": {
            "properties": {
              "expected": { "$ref": "#/$defs/text" },
              "observed": { "$ref": "#/$defs/text" },
              "repro": { "$ref": "#/$defs/text" }
            }
          }
        },
        {
          "description": "A Verified or Failed claim must say how it was checked.",
          "if": { "properties": { "verdict": { "enum": ["Verified", "Failed"] } } },
          "then": { "properties": { "method": { "enum": ["executed", "inspected"] } } }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "applicable", "applicability_reason", "verdict", "evidence", "flags"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/text" },
        "applicable": { "type": "boolean" },
        "applicability_reason": { "$ref": "#/$defs/text" },
        "verdict": {
          "description": "Followed, Broken or Unverified when applicable; null when not applicable.",
          "enum": ["Followed", "Broken", "Unverified", null]
        },
        "evidence": { "$ref": "#/$defs/text" },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(not_considered|ambiguous|conflicts_with:.+)$"
          }
        }
      },
      "if": { "properties": { "applicable": { "const": true } } },
      "then": { "properties": { "verdict": { "enum": ["Followed", "Broken", "Unverified"] } } },
      "else": { "properties": { "verdict": { "const": null } } }
    },
    "rationalisation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "quote", "source", "table_entry", "new"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/text" },
        "quote": {
          "description": "A short excerpt of the builder's excuse. Leave out anything sensitive.",
          "$ref": "#/$defs/text"
        },
        "source": {
          "description": "Where the excuse appeared.",
          "enum": ["final_summary", "reasoning", "other_transcript"]
        },
        "table_entry": {
          "description": "The matching row of the rule's rationalisation table; null when new.",
          "$ref": "#/$defs/nullableText"
        },
        "new": {
          "description": "true when the excuse matches no table entry.",
          "type": "boolean"
        }
      },
      "if": { "properties": { "new": { "const": true } } },
      "then": { "properties": { "table_entry": { "type": "null" } } },
      "else": { "properties": { "table_entry": { "$ref": "#/$defs/text" } } }
    }
  }
}
